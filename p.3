            <!-- Grid: 7-Day Daily Forecast & Busan Beach Comparison Matrix -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                
                <!-- 7-Day Forecast Column -->
                <section class="lg:col-span-2 glass-panel rounded-3xl p-5 sm:p-6 space-y-4 border border-white/10">
                    <div>
                        <h3 class="text-lg font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-calendar-week text-sky-400"></i> 7-Day Ocean &amp; Atmosphere Outlook
                        </h3>
                        <p class="text-xs text-slate-400">Extended outdoor planning for beach trips, swimming, and surfing</p>
                    </div>

                    <div id="daily-forecast-container" class="space-y-2.5">
                        <!-- Dynamically populated daily items -->
                    </div>
                </section>

                <!-- Busan Beaches Snapshot Comparison Column -->
                <section class="glass-panel rounded-3xl p-5 sm:p-6 space-y-4 border border-white/10 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between">
                            <h3 class="text-lg font-bold text-white flex items-center gap-2">
                                <i class="fa-solid fa-layer-group text-teal-400"></i> Coastal Comparison
                            </h3>
                            <button onclick="fetchAllBeachesSnapshot()" class="text-xs text-sky-400 hover:text-sky-300 font-semibold">
                                Sync All
                            </button>
                        </div>
                        <p class="text-xs text-slate-400">Compare all 8 Busan coastal spots at once</p>
                    </div>

                    <div id="comparison-list" class="space-y-2 my-2 max-h-[380px] overflow-y-auto pr-1">
                        <!-- Populated by JS -->
                    </div>

                    <!-- Quick Advisory Box -->
                    <div class="p-4 rounded-2xl bg-gradient-to-br from-sky-950/80 to-slate-900 border border-sky-500/20 text-xs space-y-1.5">
                        <span class="font-bold text-sky-300 flex items-center gap-1.5">
                            <i class="fa-solid fa-circle-info"></i> Beach Tip &amp; Safety Note
                        </span>
                        <p id="beach-tip-text" class="text-slate-300 leading-relaxed">
                            Songjeong and Imrang are favored for surfing swell, while Gwangalli, Haeundae, and Songdo offer scenic beachwalks.
                        </p>
                    </div>
                </section>

            </div>

        </div>

    </main>

    <!-- Application Footer -->
    <footer class="glass-panel mt-12 border-t border-white/10 py-6 text-center text-xs text-slate-400">
        <div class="max-w-7xl mx-auto px-4 space-y-2">
            <div class="flex items-center justify-center space-x-2">
                <span class="font-semibold text-slate-300">BusanSurf &amp; Sun Live Tracker</span>
                <span>•</span>
                <span>Powered by <a href="https://open-meteo.com/" target="_blank" rel="noopener" class="text-sky-400 hover:underline">Open-Meteo APIs</a></span>
            </div>
            <p class="text-slate-400">Real-time ocean marine and atmospheric forecast for Haeundae, Gwangalli, Songjeong, Dadaepo, Songdo, Ilgwang, Imrang, and Taejongdae.</p>
        </div>
    </footer>

    <!-- JavaScript Logic -->
    <script>
        // ==========================================
        // 1. CONFIGURATION & CONSTANTS (8 BEACH SPOTS)
        // ==========================================
        const BUSAN_BEACHES = [
            {
                id: 'haeundae',
                name: 'Haeundae Beach',
                nameKr: '해운대해수욕장',
                lat: 35.1587,
                lng: 129.1601,
                desc: "Busan's iconic sand strip with scenic urban ocean vistas.",
                bestFor: 'Swimming & Sunbathing'
            },
            {
                id: 'gwangalli',
                name: 'Gwangalli Beach',
                nameKr: '광안리해수욕장',
                lat: 35.1532,
                lng: 129.1189,
                desc: 'Famous for night views of Gwangandaegyo Bridge and SUP paddleboarding.',
                bestFor: 'Night Strolls & SUP'
            },
            {
                id: 'songjeong',
                name: 'Songjeong Beach',
                nameKr: '송정해수욕장',
                lat: 35.1786,
                lng: 129.1997,
                desc: 'South Korea’s premier surfing hotspot with consistent wave swell.',
                bestFor: 'Surfing & Board Sports'
            },
            {
                id: 'dadaepo',
                name: 'Dadaepo Beach',
                nameKr: '다대포해수욕장',
                lat: 35.0468,
                lng: 128.9642,
                desc: 'Spacious sunset beach known for golden sands and shallow tidal flats.',
                bestFor: 'Sunsets & Coastal Walks'
            },
            {
                id: 'songdo',
                name: 'Songdo Beach',
                nameKr: '송도해수욕장',
                lat: 35.0764,
                lng: 129.0234,
                desc: 'Korea’s first public beach featuring sea cable cars and ocean walkways.',
                bestFor: 'Sightseeing & Family Trips'
            },
            {
                id: 'ilgwang',
                name: 'Ilgwang Beach',
                nameKr: '일광해수욕장',
                lat: 35.2605,
                lng: 129.2335,
                desc: 'Quiet curved bay with shallow, calm waters ideal for relaxing.',
                bestFor: 'Calm Swim & Relaxation'
            },
            {
                id: 'imrang',
                name: 'Imrang Beach',
                nameKr: '임랑해수욕장',
                lat: 35.3183,
                lng: 129.2638,
                desc: 'Scenic northern coastal spot popular for surfing and seaside camping.',
                bestFor: 'Coastal Camping & Surfing'
            },
            {
                id: 'taejongdae',
                name: 'Taejongdae / Oryukdo',
                nameKr: '태종대/오륙도',
                lat: 35.0538,
                lng: 129.0872,
                desc: 'Dramatic coastal cliffs, lighthouse views, and open ocean currents.',
                bestFor: 'Ocean Views & Trekking'
            }
        ];

        // 100% Free & Open Map API Providers (No API Key Required)
        const MAP_STYLES = {
            dark: {
                url: 'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png',
                attr: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" class="text-sky-400">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions" target="_blank" class="text-sky-400">CARTO</a>',
                maxZoom: 19
            },
            street: {
                url: 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
                attr: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" class="text-sky-400">OpenStreetMap</a> contributors',
                maxZoom: 19
            },
            satellite: {
                url: 'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
                attr: 'Tiles &copy; Esri &mdash; Source: Esri, i-cubed, USDA, USGS, AEX, GeoEye, Getmapping, Aerogrid, IGN, IGP, UPR-EGP, and the GIS User Community',
                maxZoom: 18
            },
            voyager: {
                url: 'https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png',
                attr: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" class="text-sky-400">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions" target="_blank" class="text-sky-400">CARTO</a>',
                maxZoom: 19
            }
        };

        // State variables
        let selectedBeachId = localStorage.getItem('busan_beach_id') || 'haeundae';
        let tempUnit = localStorage.getItem('busan_temp_unit') || 'C';
        let speedUnit = localStorage.getItem('busan_speed_unit') || 'm/s';
        let selectedDate = new Date().toISOString().split('T')[0];
        let currentStyleKey = 'dark';
        
        let currentWeatherData = null;
        let currentMarineData = null;
        let comparisonCache = {};
        let autoRefreshInterval = null;

        // Leaflet Map state
        let leafletMap = null;
        let mapTileLayer = null;
        let mapMarkers = {};
        let userLocationMarker = null;

        // WMO Code Interpreter mapping
        const WMO_CODES = {
            0: { label: 'Clear Sky', icon: 'fa-sun', color: 'text-amber-400' },
            1: { label: 'Mainly Clear', icon: 'fa-cloud-sun', color: 'text-amber-300' },
            2: { label: 'Partly Cloudy', icon: 'fa-cloud-sun', color: 'text-slate-300' },
            3: { label: 'Overcast', icon: 'fa-cloud', color: 'text-slate-400' },
            45: { label: 'Foggy', icon: 'fa-smog', color: 'text-slate-400' },
            48: { label: 'Depositing Fog', icon: 'fa-smog', color: 'text-slate-400' },
            51: { label: 'Light Drizzle', icon: 'fa-cloud-rain', color: 'text-sky-300' },
            53: { label: 'Moderate Drizzle', icon: 'fa-cloud-rain', color: 'text-sky-400' },
            55: { label: 'Dense Drizzle', icon: 'fa-cloud-showers-heavy', color: 'text-sky-500' },
            61: { label: 'Slight Rain', icon: 'fa-cloud-rain', color: 'text-blue-400' },
            63: { label: 'Moderate Rain', icon: 'fa-cloud-showers-heavy', color: 'text-blue-500' },
            65: { label: 'Heavy Rain', icon: 'fa-cloud-showers-water', color: 'text-blue-600' },
            80: { label: 'Rain Showers', icon: 'fa-cloud-sun-rain', color: 'text-sky-400' },
            81: { label: 'Moderate Showers', icon: 'fa-cloud-showers-heavy', color: 'text-blue-400' },
            82: { label: 'Violent Showers', icon: 'fa-cloud-showers-water', color: 'text-indigo-400' },
            95: { label: 'Thunderstorm', icon: 'fa-bolt-lightning', color: 'text-amber-500' },
            96: { label: 'Thunderstorm & Hail', icon: 'fa-cloud-bolt', color: 'text-red-400' }
        };

        // ==========================================
        // 2. HELPER UTILITIES
        // ==========================================
        function getWmoInfo(code) {
            return WMO_CODES[code] || { label: 'Variable Weather', icon: 'fa-cloud', color: 'text-slate-300' };
        }

        function formatTemp(celsius) {
            if (celsius === null || celsius === undefined) return '--';
            if (tempUnit === 'F') {
                return Math.round((celsius * 9/5) + 32) + '°F';
            }
            return Math.round(celsius) + '°C';
        }

        function formatSpeed(ms) {
            if (ms === null || ms === undefined) return '--';
            if (speedUnit === 'km/h') {
                return (ms * 3.6).toFixed(1) + ' km/h';
            }
            return ms.toFixed(1) + ' m/s';
        }

        function getWindDirectionLabel(deg) {
            const directions = ['N', 'NE', 'E', 'SE', 'S', 'SW', 'W', 'NW'];
            return directions[Math.round(deg / 45) % 8];
        }

        function getBeaufortScaleText(speedMs) {
            if (speedMs < 0.5) return 'Calm mirror sea';
            if (speedMs < 1.6) return 'Light ripples';
            if (speedMs < 3.4) return 'Light breeze (ideal)';
            if (speedMs < 5.5) return 'Gentle breeze';
            if (speedMs < 8.0) return 'Moderate breeze';
            if (speedMs < 10.8) return 'Fresh breeze (choppy)';
            return 'Strong wind alert';
        }

        function getUvRating(uv) {
            if (uv <= 2) return { text: 'Low', color: 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30' };
            if (uv <= 5) return { text: 'Moderate', color: 'bg-amber-500/20 text-amber-300 border-amber-500/30' };
            if (uv <= 7) return { text: 'High', color: 'bg-orange-500/20 text-orange-300 border-orange-500/30' };
            if (uv <= 10) return { text: 'Very High', color: 'bg-red-500/20 text-red-300 border-red-500/30' };
            return { text: 'Extreme', color: 'bg-purple-500/20 text-purple-300 border-purple-500/30' };
        }

        function getSurfSafetyRating(waveHeight, windSpeed) {
            if (waveHeight >= 1.2 && waveHeight <= 2.5) {
                return { text: 'Surf: Great Waves!', color: 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30' };
            } else if (waveHeight < 0.5) {
                return { text: 'Surf: Flat Waters', color: 'bg-slate-500/20 text-slate-300 border-slate-500/30' };
            } else if (waveHeight > 2.5 || windSpeed > 10.0) {
                return { text: 'Surf: High Swell Warning', color: 'bg-red-500/20 text-red-300 border-red-500/30' };
            }
            return { text: 'Surf: Moderate Swell', color: 'bg-sky-500/20 text-sky-300 border-sky-500/30' };
        }

        function getSwimSafetyRating(waveHeight, weatherCode) {
            const isRainyOrStormy = [61, 63, 65, 80, 81, 82, 95, 96].includes(weatherCode);
            if (isRainyOrStormy) {
                return { text: 'Swim: Caution (Rain/Storm)', color: 'bg-amber-500/20 text-amber-300 border-amber-500/30' };
            }
            if (waveHeight < 1.0) {
                return { text: 'Swim: Calm & Favorable', color: 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30' };
            } else if (waveHeight <= 1.8) {
                return { text: 'Swim: Moderate Waves', color: 'bg-amber-500/20 text-amber-300 border-amber-500/30' };
            }
            return { text: 'Swim: Hazardous Waves', color: 'bg-red-500/20 text-red-300 border-red-500/30' };
        }

        function scrollToMap() {
            const mapSec = document.getElementById('map-section');
            if (mapSec) {
                mapSec.scrollIntoView({ behavior: 'smooth' });
            }
        }

        // Date Picker Handlers
        function getTodayStr() {
            return new Date().toISOString().split('T')[0];
        }

        function onDateChange(dateVal) {
            if (!dateVal) return;
            selectedDate = dateVal;
            const todayStr = getTodayStr();
            const todayBtn = document.getElementById('today-btn');
            if (todayBtn) {
                if (selectedDate !== todayStr) {
                    todayBtn.classList.remove('hidden');
                } else {
                    todayBtn.classList.add('hidden');
                }
            }
            fetchBeachData(true);
        }

        function resetToToday() {
            const todayStr = getTodayStr();
            selectedDate = todayStr;
            const datePicker = document.getElementById('date-picker');
            if (datePicker) datePicker.value = todayStr;
            const todayBtn = document.getElementById('today-btn');
            if (todayBtn) todayBtn.classList.add('hidden');
            fetchBeachData(true);
        }

        // ==========================================
        // 3. LEAFLET INTERACTIVE MAP LOGIC
        // ==========================================
        function createTileLayer(styleKey) {
            const style = MAP_STYLES[styleKey] || MAP_STYLES.dark;
            const layer = L.tileLayer(style.url, {
                maxZoom: style.maxZoom,
                subdomains: 'abcd',
                attribution: style.attr
            });

            // Graceful fallback to OpenStreetMap standard tiles if any tile network request fails
            layer.on('tileerror', function(error) {
                console.warn('Free tile fetch warning. Operating on open tile fallback.', error);
            });

            return layer;
        }

        function initLeafletMap() {
            if (leafletMap) return;

            // Center of Busan coastline
            const mapCenter = [35.1500, 129.1300];
            
            // Initialize map with Leaflet open engine
            leafletMap = L.map('busan-map', {
                zoomControl: true,
                attributionControl: true
            }).setView(mapCenter, 11);

            // Add initial tile layer from free map API
            mapTileLayer = createTileLayer(currentStyleKey).addTo(leafletMap);

            // Generate Map Markers
            renderMapMarkers();
        }

        function renderMapMarkers() {
            if (!leafletMap) return;

            BUSAN_BEACHES.forEach(beach => {
                const isActive = beach.id === selectedBeachId;
                const cacheData = comparisonCache[beach.id];

                const tempVal = cacheData ? formatTemp(cacheData.temp) : '--';
                const waveVal = cacheData && cacheData.wave !== undefined ? cacheData.wave.toFixed(1) + 'm' : '--';

                // Safety Glow Ring Class
                let ringClass = 'wave-ring-calm';
                if (cacheData && cacheData.wave > 1.8) ringClass = 'wave-ring-rough';
                else if (cacheData && cacheData.wave >= 1.0) ringClass = 'wave-ring-moderate';

                const iconHtml = `
                    <div class="map-live-marker ${isActive ? 'beach-marker-active' : ''}">
                        <div class="marker-data-pill">
                            <i class="fa-solid fa-temperature-three-quarters text-amber-400"></i>
                            <span>${tempVal}</span>
                            <span class="opacity-40">|</span>
                            <i class="fa-solid fa-water text-cyan-300"></i>
                            <span>${waveVal}</span>
                        </div>
                        <div class="beach-marker-pin ${ringClass} ${isActive ? 'bg-gradient-to-r from-sky-400 to-cyan-400 text-slate-950' : 'bg-slate-900 text-sky-400 border border-sky-500/40'}">
                            <i class="fa-solid fa-water"></i>
                        </div>
                    </div>
                `;

                const customIcon = L.divIcon({
                    className: 'custom-leaflet-divicon',
                    html: iconHtml,
                    iconSize: [100, 60],
                    iconAnchor: [50, 60],
                    popupAnchor: [0, -62]
                });

                if (mapMarkers[beach.id]) {
                    mapMarkers[beach.id].setIcon(customIcon);
                } else {
                    const marker = L.marker([beach.lat, beach.lng], { icon: customIcon }).addTo(leafletMap);
                    marker.on('click', () => selectBeach(beach.id));
                    mapMarkers[beach.id] = marker;
                }
            });

            updateMapPopups();
        }

        function updateMapPopups() {
            if (!leafletMap) return;

            BUSAN_BEACHES.forEach(beach => {
                const marker = mapMarkers[beach.id];
                if (!marker) return;

                const cacheData = comparisonCache[beach.id];
                const tempStr = cacheData ? formatTemp(cacheData.temp) : '--';
                const waveStr = cacheData && cacheData.wave !== undefined ? cacheData.wave.toFixed(1) + ' m wave' : 'Loading...';
                const wmo = cacheData ? getWmoInfo(cacheData.weatherCode) : { icon: 'fa-sun', color: 'text-amber-400', label: 'Clear' };

                const popupHtml = `
                    <div class="p-2.5 space-y-2 min-w-[180px] text-left">
                        <div class="flex items-center justify-between border-b border-white/10 pb-2">
                            <div>
                                <h4 class="font-extrabold text-sm text-white">${beach.name}</h4>
                                <span class="text-[10px] text-sky-300 font-semibold">${beach.nameKr}</span>
                            </div>
                            <i class="fa-solid ${wmo.icon} ${wmo.color} text-xl"></i>
                        </div>
                        <div class="flex items-center justify-between text-xs pt-0.5">
                            <span class="text-slate-200 font-bold"><i class="fa-solid fa-temperature-half text-amber-400 mr-1"></i>${tempStr}</span>
                            <span class="text-cyan-300 font-bold"><i class="fa-solid fa-water mr-1"></i>${waveStr}</span>
                        </div>
                        <p class="text-[10px] text-slate-300 leading-tight">${beach.desc}</p>
                        <button onclick="selectBeach('${beach.id}')" class="w-full mt-2 py-1.5 px-3 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-extrabold text-[11px] transition text-center shadow-lg">
                            Activate Beach Dashboard
                        </button>
                    </div>
                `;

                marker.bindPopup(popupHtml);
            });
        }

        function highlightMapBeach(beachId) {
            if (!leafletMap) return;

            const beach = BUSAN_BEACHES.find(b => b.id === beachId);
            if (!beach) return;

            leafletMap.invalidateSize();

            leafletMap.flyTo([beach.lat, beach.lng], 13, {
                animate: true,
                duration: 1.2
            });

            // Re-render markers to update active styling
            renderMapMarkers();

            if (mapMarkers[beachId]) {
                setTimeout(() => {
                    if (mapMarkers[beachId]) mapMarkers[beachId].openPopup();
                }, 300);
            }
        }

        function switchMapStyle(styleKey) {
            if (!leafletMap || !MAP_STYLES[styleKey]) return;
            currentStyleKey = styleKey;

            if (mapTileLayer) leafletMap.removeLayer(mapTileLayer);
            mapTileLayer = createTileLayer(styleKey).addTo(leafletMap);

            // Update layer toggle buttons
            ['dark', 'street', 'satellite', 'voyager'].forEach(k => {
                const btn = document.getElementById(`map-style-${k}`);
                if (btn) {
                    if (k === styleKey) {
                        btn.className = 'px-2.5 py-1 rounded-lg font-semibold bg-sky-500 text-slate-950 transition';
                    } else {
                        btn.className = 'px-2.5 py-1 rounded-lg font-semibold text-slate-400 hover:text-white transition';
                    }
                }
            });
        }

        // GPS Geolocate Closest Beach
        function locateUserPosition() {
            if (!navigator.geolocation) {
                alert('Geolocation is not supported by your browser.');
                return;
            }

            navigator.geolocation.getCurrentPosition(
                (position) => {
                    const userLat = position.coords.latitude;
                    const userLng = position.coords.longitude;

                    if (!leafletMap) return;

                    // Remove previous user marker
                    if (userLocationMarker) leafletMap.removeLayer(userLocationMarker);

                    const userIcon = L.divIcon({
                        className: 'custom-user-pin',
                        html: `<div class="w-6 h-6 rounded-full bg-emerald-400 border-2 border-white shadow-lg animate-ping"></div>`,
                        iconSize: [24, 24]
                    });

                    userLocationMarker = L.marker([userLat, userLng], { icon: userIcon }).addTo(leafletMap);
                    userLocationMarker.bindPopup('<div class="p-1 text-xs text-center font-bold text-emerald-300">Your Current Location</div>').openPopup();

                    // Find closest beach using Haversine distance
                    let closestBeach = BUSAN_BEACHES[0];
                    let minDistance = Infinity;

                    BUSAN_BEACHES.forEach(b => {
                        const dist = Math.hypot(b.lat - userLat, b.lng - userLng);
                        if (dist < minDistance) {
                            minDistance = dist;
                            closestBeach = b;
                        }
                    });

                    selectBeach(closestBeach.id);
                },
                (err) => {
                    console.warn('GPS location access denied or unavailable.', err);
                    alert('Unable to retrieve location. Defaulting to Haeundae Beach.');
                }
            );
        }

        // ==========================================
        // 4. UI INITIALIZATION & TABS
        // ==========================================
        function renderBeachTabs() {
            const container = document.getElementById('beach-tabs');
            container.innerHTML = BUSAN_BEACHES.map(beach => {
                const isActive = beach.id === selectedBeachId;
                const activeClasses = isActive 
                    ? 'bg-gradient-to-r from-sky-500 to-teal-500 text-slate-950 font-bold shadow-lg shadow-sky-500/20 border-sky-400' 
                    : 'glass-card text-slate-300 hover:text-white glass-card-hover border-white/10';

                return `
                    <button onclick="selectBeach('${beach.id}')" class="px-2.5 py-2.5 rounded-2xl flex flex-col items-start justify-between border text-left transition-all ${activeClasses}">
                        <div class="flex items-center justify-between w-full">
                            <span class="text-[11px] ${isActive ? 'text-slate-950 font-extrabold' : 'text-sky-300 font-semibold'}">${beach.nameKr}</span>
                            ${isActive ? '<i class="fa-solid fa-circle-check text-slate-950 text-xs"></i>' : ''}
                        </div>
                        <div class="mt-1">
                            <h3 class="text-xs tracking-tight font-extrabold leading-tight ${isActive ? 'text-slate-950' : 'text-white'}">${beach.name}</h3>
                        </div>
                    </button>
                `;
            }).join('');
        }

        function selectBeach(beachId) {
            if (selectedBeachId === beachId && currentWeatherData) {
                highlightMapBeach(beachId);
                return;
            }
            selectedBeachId = beachId;
            localStorage.setItem('busan_beach_id', beachId);
            renderBeachTabs();
            fetchBeachData();
            highlightMapBeach(beachId);
        }

        function setTemperatureUnit(unit) {
            tempUnit = unit;
            localStorage.setItem('busan_temp_unit', unit);
            document.getElementById('unit-c').className = unit === 'C' ? 'px-2.5 py-1 rounded-lg font-bold transition-colors bg-sky-500 text-slate-950 shadow' : 'px-2.5 py-1 rounded-lg font-bold transition-colors text-slate-400 hover:text-white';
            document.getElementById('unit-f').className = unit === 'F' ? 'px-2.5 py-1 rounded-lg font-bold transition-colors bg-sky-500 text-slate-950 shadow' : 'px-2.5 py-1 rounded-lg font-bold transition-colors text-slate-400 hover:text-white';
            
            if (currentWeatherData && currentMarineData) {
                renderDashboard();
                renderMapMarkers();
            }
        }

        function setSpeedUnit(unit) {
            speedUnit = unit;
            localStorage.setItem('busan_speed_unit', unit);
            document.getElementById('unit-ms').className = unit === 'm/s' ? 'px-2.5 py-1 rounded-lg font-bold transition-colors bg-sky-500 text-slate-950 shadow' : 'px-2.5 py-1 rounded-lg font-bold transition-colors text-slate-400 hover:text-white';
            document.getElementById('unit-kmh').className = unit === 'km/h' ? 'px-2.5 py-1 rounded-lg font-bold transition-colors bg-sky-500 text-slate-950 shadow' : 'px-2.5 py-1 rounded-lg font-bold transition-colors text-slate-400 hover:text-white';
            
            if (currentWeatherData && currentMarineData) {
