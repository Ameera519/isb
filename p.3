        function toggleHourlyView(view) {
            const cards = document.getElementById('hourly-cards-container');
            const chart = document.getElementById('hourly-chart-container');
            const btnCards = document.getElementById('hourly-tab-cards');
            const btnChart = document.getElementById('hourly-tab-chart');

