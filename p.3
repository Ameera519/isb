                            <button id="map-style-voyager" onclick="switchMapStyle('voyager')" class="px-2.5 py-1 rounded-lg font-semibold text-slate-400 hover:text-white transition">
                                CARTO Voyager
                            </button>
                        </div>

                        <!-- GPS Button -->
                        <button onclick="locateUserPosition()" class="px-3 py-1.5 bg-sky-500/20 hover:bg-sky-500/30 text-sky-300 rounded-xl text-xs font-semibold border border-sky-500/30 transition flex items-center gap-1.5">
                            <i class="fa-solid fa-location-crosshairs"></i>
                            <span>Find My Spot</span>
                        </button>
                    </div>
                </div>

                <!-- Leaflet Canvas Map -->
                <div class="relative w-full h-[400px] sm:h-[480px] rounded-2xl overflow-hidden border border-white/10 shadow-2xl">
                    <div id="busan-map" class="w-full h-full"></div>

                    <!-- Map Floating Legend Overlay -->
                    <div class="absolute bottom-4 left-4 z-[500] bg-slate-950/85 backdrop-blur-md p-3 rounded-2xl border border-white/10 text-[11px] space-y-1.5 shadow-xl hidden sm:block">
                        <div class="font-extrabold text-slate-200 border-b border-white/10 pb-1 mb-1">Wave Safety Glow</div>
                        <div class="flex items-center gap-2 text-emerald-300">
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 inline-block shadow"></span>
                            <span>Calm Swell (&lt; 1.0m)</span>
                        </div>
                        <div class="flex items-center gap-2 text-amber-300">
                            <span class="w-2.5 h-2.5 rounded-full bg-amber-400 inline-block shadow"></span>
                            <span>Moderate Waves (1.0m - 1.8m)</span>
                        </div>
                        <div class="flex items-center gap-2 text-red-300">
                            <span class="w-2.5 h-2.5 rounded-full bg-red-400 inline-block shadow"></span>
                            <span>Rough Swell (&gt; 1.8m)</span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Hourly Ocean & Weather Forecast (24-Hour) -->
            <section class="glass-panel rounded-3xl p-5 sm:p-6 space-y-4 border border-white/10">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <div>
                        <h3 class="text-lg font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-clock-rotate-left text-sky-400"></i> 24-Hour Beach Forecast
                        </h3>
                        <p class="text-xs text-slate-400">Hourly air temperature, wave heights, and rain probabilities</p>
                    </div>

                    <!-- Hourly View Switcher -->
                    <div class="flex items-center space-x-1 bg-slate-900/80 p-1 rounded-xl border border-white/10 text-xs self-start sm:self-auto">
                        <button id="hourly-tab-cards" onclick="toggleHourlyView('cards')" class="px-3 py-1 rounded-lg font-medium bg-sky-500 text-slate-950 transition">
                            <i class="fa-solid fa-border-all mr-1"></i> Cards
                        </button>
                        <button id="hourly-tab-chart" onclick="toggleHourlyView('chart')" class="px-3 py-1 rounded-lg font-medium text-slate-400 hover:text-white transition">
                            <i class="fa-solid fa-chart-line mr-1"></i> Visual Chart
                        </button>
                    </div>
                </div>

                <!-- View 1: Scrollable Hourly Cards -->
                <div id="hourly-cards-container" class="flex space-x-3 overflow-x-auto pb-3 pt-1 scroll-smooth">
                    <!-- Dynamic Hourly Cards populated by JS -->
                </div>

                <!-- View 2: Visual SVG Graph -->
                <div id="hourly-chart-container" class="hidden pt-2">
                    <div class="bg-slate-950/60 p-4 rounded-2xl border border-white/5 space-y-2">
                        <div class="flex items-center justify-between text-xs text-slate-400 px-2">
                            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-amber-400 inline-block"></span> Temperature (°C)</span>
                            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-cyan-400 inline-block"></span> Wave Height (m)</span>
                        </div>
                        <div class="w-full overflow-x-auto">
                            <svg id="hourly-svg-chart" class="w-full h-48 min-w-[650px]" preserveAspectRatio="none">
                                <!-- SVG Chart content drawn dynamically -->
