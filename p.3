        // ==========================================
        // 5. API FETCHING LOGIC
        // ==========================================
        async function fetchBeachData(isManual = false) {
            const beach = BUSAN_BEACHES.find(b => b.id === selectedBeachId) || BUSAN_BEACHES[0];

            const refreshIcon = document.getElementById('refresh-icon');
            if (isManual && refreshIcon) refreshIcon.classList.add('fa-spin');

            const isInitialLoad = !currentWeatherData;
            if (isInitialLoad) {
                document.getElementById('loading-skeleton').classList.remove('hidden');
                document.getElementById('dashboard-content').classList.add('hidden');
            }
            document.getElementById('error-banner').classList.add('hidden');

            try {
                // Calculate date range for Open-Meteo forecast (selected date + 6 days)
                const startDateObj = new Date(selectedDate);
                const endDateObj = new Date(startDateObj);
                endDateObj.setDate(startDateObj.getDate() + 6);
                const endDateStr = endDateObj.toISOString().split('T')[0];

                const weatherUrl = `https://api.open-meteo.com/v1/forecast?latitude=${beach.lat}&longitude=${beach.lng}&start_date=${selectedDate}&end_date=${endDateStr}&current=temperature_2m,relative_humidity_2m,apparent_temperature,is_day,weather_code,wind_speed_10m,wind_direction_10m&hourly=temperature_2m,precipitation_probability,weather_code,uv_index,wind_speed_10m&daily=weather_code,temperature_2m_max,temperature_2m_min,sunrise,sunset,uv_index_max&timezone=Asia%2FSeoul`;

                const marineUrl = `https://marine-api.open-meteo.com/v1/marine?latitude=${beach.lat}&longitude=${beach.lng}&start_date=${selectedDate}&end_date=${endDateStr}&current=wave_height,wave_direction,wave_period&hourly=wave_height,wave_period&timezone=Asia%2FSeoul`;

                const [weatherRes, marineRes] = await Promise.all([
                    fetch(weatherUrl),
                    fetch(marineUrl)
                ]);

                if (!weatherRes.ok || !marineRes.ok) {
                    throw new Error('Failed to fetch weather or marine response.');
                }

                currentWeatherData = await weatherRes.json();
                currentMarineData = await marineRes.json();

                // Cache for comparison tab & map popups
                comparisonCache[beach.id] = {
                    temp: currentWeatherData.current.temperature_2m,
                    wave: currentMarineData.current.wave_height,
                    weatherCode: currentWeatherData.current.weather_code,
                    wind: currentWeatherData.current.wind_speed_10m
                };

                document.getElementById('loading-skeleton').classList.add('hidden');
                document.getElementById('dashboard-content').classList.remove('hidden');

                // Render UI components
                renderDashboard();

                if (!leafletMap) {
                    initLeafletMap();
                } else {
                    leafletMap.invalidateSize();
                }
                
                renderMapMarkers();
                highlightMapBeach(beach.id);

                const now = new Date();
                document.getElementById('last-updated-text').textContent = `Updated at ${now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;

                // Also trigger snapshot update for all beaches
                fetchAllBeachesSnapshot();

            } catch (err) {
                console.error("Error fetching beach data:", err);
                document.getElementById('error-banner').classList.remove('hidden');
                document.getElementById('error-message').textContent = err.message || 'Error connecting to weather services.';
            } finally {
                document.getElementById('loading-skeleton').classList.add('hidden');
                document.getElementById('dashboard-content').classList.remove('hidden');
                if (refreshIcon) refreshIcon.classList.remove('fa-spin');
                
                if (leafletMap) {
                    setTimeout(() => leafletMap.invalidateSize(), 100);
                }
            }
        }

        // Snapshot comparison fetch for all beaches
        async function fetchAllBeachesSnapshot() {
            const listContainer = document.getElementById('comparison-list');
            
            try {
                const promises = BUSAN_BEACHES.map(async (beach) => {
                    if (comparisonCache[beach.id]) return { beach, data: comparisonCache[beach.id] };

                    const wUrl = `https://api.open-meteo.com/v1/forecast?latitude=${beach.lat}&longitude=${beach.lng}&current=temperature_2m,weather_code,wind_speed_10m&timezone=Asia%2FSeoul`;
                    const mUrl = `https://marine-api.open-meteo.com/v1/marine?latitude=${beach.lat}&longitude=${beach.lng}&current=wave_height&timezone=Asia%2FSeoul`;

                    const [wRes, mRes] = await Promise.all([fetch(wUrl), fetch(mUrl)]);
                    const wData = await wRes.json();
                    const mData = await mRes.json();

                    const item = {
                        temp: wData.current?.temperature_2m,
                        wave: mData.current?.wave_height,
                        weatherCode: wData.current?.weather_code,
                        wind: wData.current?.wind_speed_10m
                    };
                    comparisonCache[beach.id] = item;
                    return { beach, data: item };
                });

                const results = await Promise.all(promises);

                listContainer.innerHTML = results.map(({ beach, data }) => {
                    const wmo = getWmoInfo(data.weatherCode);
                    const isSelected = beach.id === selectedBeachId;

                    return `
                        <div onclick="selectBeach('${beach.id}')" class="p-2.5 rounded-2xl glass-card flex items-center justify-between cursor-pointer border ${isSelected ? 'border-sky-400 bg-sky-500/10' : 'border-white/5 hover:border-white/20'} transition">
                            <div class="flex items-center space-x-2.5">
                                <i class="fa-solid ${wmo.icon} ${wmo.color} text-base"></i>
                                <div>
                                    <h4 class="text-xs font-extrabold text-white flex items-center gap-1.5">
                                        ${beach.name}
                                        ${isSelected ? '<span class="text-[8px] bg-sky-500 text-slate-950 font-extrabold px-1.5 py-0.2 rounded">Active</span>' : ''}
                                    </h4>
                                    <p class="text-[10px] text-slate-400">${beach.bestFor}</p>
                                </div>
                            </div>

                            <div class="text-right">
                                <div class="text-xs font-extrabold text-white">${formatTemp(data.temp)}</div>
                                <div class="text-[10px] text-cyan-300 font-medium">${data.wave !== undefined && data.wave !== null ? data.wave.toFixed(1) + ' m wave' : 'N/A'}</div>
                            </div>
                        </div>
                    `;
                }).join('');

                renderMapMarkers();

            } catch (e) {
                console.error("Comparison fetch error", e);
                listContainer.innerHTML = `<div class="text-xs text-slate-400">Unable to load beach comparison</div>`;
            }
        }

        // ==========================================
        // 6. DASHBOARD RENDERING
        // ==========================================
        function renderDashboard() {
            if (!currentWeatherData || !currentMarineData) return;

            const beach = BUSAN_BEACHES.find(b => b.id === selectedBeachId);
            const currW = currentWeatherData.current;
            const currM = currentMarineData.current;
            const dailyW = currentWeatherData.daily;

            // Beach Title
            document.getElementById('current-beach-name').textContent = beach.name;
            document.getElementById('current-beach-kr').textContent = beach.nameKr;
            document.getElementById('current-beach-desc').textContent = beach.desc;
            document.getElementById('beach-tip-text').textContent = `Recommended for ${beach.bestFor}. ` + beach.desc;

            // Date Badge update
            const dateBadge = document.getElementById('selected-date-badge');
            const todayStr = getTodayStr();
            if (selectedDate !== todayStr) {
                dateBadge.textContent = `Target Date: ${selectedDate}`;
                dateBadge.classList.remove('hidden');
            } else {
                dateBadge.classList.add('hidden');
            }

            // Weather & WMO
            const wmo = getWmoInfo(currW.weather_code);
            document.getElementById('current-weather-text').textContent = wmo.label;
            const iconElem = document.getElementById('current-weather-icon');
            iconElem.className = `fa-solid ${wmo.icon} ${wmo.color} text-2xl`;

            // Temps
            document.getElementById('current-temp').textContent = formatTemp(currW.temperature_2m);
            document.getElementById('current-feels').textContent = formatTemp(currW.apparent_temperature);
            
            const minTemp = dailyW?.temperature_2m_min[0];
            const maxTemp = dailyW?.temperature_2m_max[0];
            document.getElementById('current-temp-minmax').textContent = `${formatTemp(minTemp)} / ${formatTemp(maxTemp)}`;

            // Ocean Waves
            const waveH = currM.wave_height !== undefined && currM.wave_height !== null ? currM.wave_height : 0.5;
            document.getElementById('current-wave-height').textContent = `${waveH.toFixed(1)} m`;
            document.getElementById('current-wave-period').textContent = `${currM.wave_period ? currM.wave_period.toFixed(1) : '--'}s`;
            
            const waveDirLabel = currM.wave_direction !== undefined ? getWindDirectionLabel(currM.wave_direction) : 'SE';
            document.getElementById('current-wave-dir').textContent = `${waveDirLabel} (${Math.round(currM.wave_direction || 0)}°)`;

            // Wave Qualifier
            let waveQual = 'Calm';
            if (waveH > 2.0) waveQual = 'Rough Swell';
            else if (waveH > 1.2) waveQual = 'Moderate Waves';
            else if (waveH > 0.6) waveQual = 'Gentle Swell';
            document.getElementById('current-wave-qual').textContent = waveQual;

            // Wind
            document.getElementById('current-wind-speed').textContent = formatSpeed(currW.wind_speed_10m);
            const windDirLabel = getWindDirectionLabel(currW.wind_direction_10m);
            document.getElementById('current-wind-dir').textContent = windDirLabel;
            document.getElementById('wind-bft-text').textContent = getBeaufortScaleText(currW.wind_speed_10m);

            // Compass Icon Rotation
            const compass = document.getElementById('wind-compass-icon');
            if (compass) compass.style.transform = `rotate(${currW.wind_direction_10m}deg)`;

            // UV Index
            const maxUvToday = dailyW?.uv_index_max[0] || 5;
            document.getElementById('current-uv-num').textContent = maxUvToday.toFixed(1);
            const uvInfo = getUvRating(maxUvToday);
            const uvBadge = document.getElementById('current-uv-badge');
            uvBadge.textContent = uvInfo.text;
            uvBadge.className = `text-xs font-bold px-2.5 py-1 rounded-full border ${uvInfo.color}`;

            // Sunrise / Sunset
            if (dailyW?.sunrise[0] && dailyW?.sunset[0]) {
                const sr = new Date(dailyW.sunrise[0]);
                const ss = new Date(dailyW.sunset[0]);
                document.getElementById('sunrise-time').textContent = sr.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                document.getElementById('sunset-time').textContent = ss.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            }

            // Quick Stats
            document.getElementById('stat-humidity').textContent = `${currW.relative_humidity_2m}%`;
            document.getElementById('stat-is-day').textContent = currW.is_day ? 'Daytime' : 'Nighttime';
            document.getElementById('stat-coords').textContent = `${beach.lat.toFixed(3)}, ${beach.lng.toFixed(3)}`;

            const rainChance = currentWeatherData.hourly?.precipitation_probability[0] || 0;
            document.getElementById('stat-rain-prob').textContent = `${rainChance}%`;

            // Safety Badges Update
            const surfBadge = getSurfSafetyRating(waveH, currW.wind_speed_10m);
            const surfElem = document.getElementById('surf-safety-badge');
            surfElem.className = `px-3 py-1.5 rounded-xl glass-card flex items-center space-x-2 border text-xs font-semibold ${surfBadge.color}`;
            document.getElementById('surf-status-text').textContent = surfBadge.text;

            const swimBadge = getSwimSafetyRating(waveH, currW.weather_code);
            const swimElem = document.getElementById('swim-safety-badge');
            swimElem.className = `px-3 py-1.5 rounded-xl glass-card flex items-center space-x-2 border text-xs font-semibold ${swimBadge.color}`;
            document.getElementById('swim-status-text').textContent = swimBadge.text;

            // Render Subsections
            renderHourlyForecast();
            renderDailyForecast();
        }

        // ==========================================
        // 7. HOURLY FORECAST & SVG CHART
        // ==========================================
        function renderHourlyForecast() {
            const container = document.getElementById('hourly-cards-container');
            const hourlyW = currentWeatherData.hourly;
            const hourlyM = currentMarineData.hourly;

            if (!hourlyW || !hourlyW.time) return;

            const todayStr = getTodayStr();
            let startIndex = 0;

            if (selectedDate === todayStr) {
                const now = new Date();
                const currentHourIso = new Date(now.getFullYear(), now.getMonth(), now.getDate(), now.getHours()).toISOString().slice(0, 13);
                startIndex = hourlyW.time.findIndex(t => t.startsWith(currentHourIso));
                if (startIndex === -1) startIndex = 0;
            }

            const next24Times = hourlyW.time.slice(startIndex, startIndex + 24);

            container.innerHTML = next24Times.map((timeStr, idx) => {
                const actualIdx = startIndex + idx;
                const dateObj = new Date(timeStr);
                const hourLabel = dateObj.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

                const temp = hourlyW.temperature_2m[actualIdx];
                const code = hourlyW.weather_code[actualIdx];
                const rainProb = hourlyW.precipitation_probability[actualIdx];
                const waveH = hourlyM?.wave_height ? hourlyM.wave_height[actualIdx] : 0.5;

                const wmo = getWmoInfo(code);

                return `
                    <div class="flex-none w-28 glass-card rounded-2xl p-3 text-center space-y-2 border border-white/5 glass-card-hover">
                        <span class="text-xs font-semibold text-slate-300">${hourLabel}</span>
                        <div class="text-xl my-1">
                            <i class="fa-solid ${wmo.icon} ${wmo.color}"></i>
                        </div>
                        <div class="text-base font-extrabold text-white">${formatTemp(temp)}</div>
                        
                        <div class="space-y-1 pt-1 border-t border-white/10 text-[10px]">
                            <div class="flex items-center justify-between text-cyan-300 font-semibold">
                                <span><i class="fa-solid fa-water"></i> Wave</span>
                                <span>${waveH !== null && waveH !== undefined ? waveH.toFixed(1) + 'm' : '--'}</span>
                            </div>
                            <div class="flex items-center justify-between text-sky-400">
                                <span><i class="fa-solid fa-droplet"></i> Rain</span>
                                <span>${rainProb}%</span>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function renderHourlySvgChart() {
            const svg = document.getElementById('hourly-svg-chart');
            const hourlyW = currentWeatherData.hourly;
            const hourlyM = currentMarineData.hourly;

            if (!hourlyW || !hourlyW.time || !svg) return;

            const todayStr = getTodayStr();
            let startIndex = 0;

            if (selectedDate === todayStr) {
                const now = new Date();
                const currentHourIso = new Date(now.getFullYear(), now.getMonth(), now.getDate(), now.getHours()).toISOString().slice(0, 13);
                startIndex = hourlyW.time.findIndex(t => t.startsWith(currentHourIso));
                if (startIndex === -1) startIndex = 0;
            }

            const count = 24;
            const temps = hourlyW.temperature_2m.slice(startIndex, startIndex + count);
            const waves = hourlyM?.wave_height ? hourlyM.wave_height.slice(startIndex, startIndex + count) : new Array(count).fill(0.5);
            const times = hourlyW.time.slice(startIndex, startIndex + count);

            const width = 650;
            const height = 180;
            const padding = 30;

            const minTemp = Math.min(...temps) - 2;
            const maxTemp = Math.max(...temps) + 2;
            const maxWave = Math.max(...waves, 2.0);

            const tempPoints = temps.map((t, i) => {
                const x = padding + (i / (count - 1)) * (width - 2 * padding);
                const y = height - padding - ((t - minTemp) / (maxTemp - minTemp)) * (height - 2 * padding);
                return { x, y, val: t, time: times[i] };
            });

            const wavePoints = waves.map((w, i) => {
                const x = padding + (i / (count - 1)) * (width - 2 * padding);
                const y = height - padding - ((w || 0) / maxWave) * (height - 2 * padding - 20);
                return { x, y, val: w };
            });

            const tempPathD = tempPoints.reduce((acc, p, i) => i === 0 ? `M ${p.x} ${p.y}` : `${acc} L ${p.x} ${p.y}`, '');
            const wavePathD = wavePoints.reduce((acc, p, i) => i === 0 ? `M ${p.x} ${p.y}` : `${acc} L ${p.x} ${p.y}`, '');

            let svgContent = `
                <defs>
                    <linearGradient id="tempGrad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#fbbf24" stop-opacity="0.3"/>
                        <stop offset="100%" stop-color="#fbbf24" stop-opacity="0.0"/>
                    </linearGradient>
                </defs>
            `;

            svgContent += `<path d="${tempPathD}" fill="none" stroke="#fbbf24" stroke-width="3" stroke-linecap="round"/>`;
            svgContent += `<path d="${wavePathD}" fill="none" stroke="#22d3ee" stroke-width="2.5" stroke-dasharray="4 2"/>`;

            tempPoints.forEach((p, i) => {
                if (i % 3 === 0) {
                    const timeLabel = new Date(p.time).getHours() + ':00';
                    svgContent += `
                        <circle cx="${p.x}" cy="${p.y}" r="4" fill="#fbbf24" />
                        <text x="${p.x}" y="${p.y - 10}" text-anchor="middle" fill="#fef08a" font-size="10" font-weight="bold">${Math.round(p.val)}°</text>
                        <text x="${p.x}" y="${height - 8}" text-anchor="middle" fill="#94a3b8" font-size="9">${timeLabel}</text>
                    `;
                }
            });

            wavePoints.forEach((p, i) => {
                if (i % 3 === 0) {
                    svgContent += `
                        <circle cx="${p.x}" cy="${p.y}" r="3" fill="#22d3ee" />
                        <text x="${p.x}" y="${p.y + 14}" text-anchor="middle" fill="#67e8f9" font-size="9">${p.val ? p.val.toFixed(1) + 'm' : ''}</text>
                    `;
                }
            });

            svg.innerHTML = svgContent;
        }

        // ==========================================
        // 8. DAILY FORECAST RENDERING
        // ==========================================
        function renderDailyForecast() {
            const container = document.getElementById('daily-forecast-container');
            const daily = currentWeatherData.daily;

            if (!daily || !daily.time) return;

            container.innerHTML = daily.time.map((timeStr, idx) => {
                const dateObj = new Date(timeStr);
                const dayName = idx === 0 ? 'Today' : dateObj.toLocaleDateString([], { weekday: 'short', month: 'numeric', day: 'numeric' });

                const minT = daily.temperature_2m_min[idx];
                const maxT = daily.temperature_2m_max[idx];
                const code = daily.weather_code[idx];
                const maxUv = daily.uv_index_max ? daily.uv_index_max[idx] : 5;

                const wmo = getWmoInfo(code);

                return `
                    <div class="p-3 sm:p-4 rounded-2xl glass-card flex items-center justify-between gap-3 border border-white/5 glass-card-hover">
                        <div class="w-28 sm:w-36">
                            <h4 class="text-xs sm:text-sm font-bold text-white">${dayName}</h4>
                            <span class="text-[10px] text-slate-400 flex items-center gap-1 mt-0.5">
                                <i class="fa-solid ${wmo.icon} ${wmo.color}"></i> ${wmo.label}
                            </span>
                        </div>

                        <div class="hidden sm:block">
                            <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-slate-800 text-amber-300 border border-amber-500/20">
                                UV ${maxUv ? maxUv.toFixed(1) : '--'}
                            </span>
                        </div>

                        <div class="flex items-center space-x-3 text-xs">
                            <span class="text-slate-400 font-medium">${formatTemp(minT)}</span>
                            <div class="w-16 sm:w-28 h-2 rounded-full bg-slate-800 overflow-hidden relative">
                                <div class="absolute h-full rounded-full bg-gradient-to-r from-sky-400 to-amber-400" style="left: 20%; right: 10%;"></div>
                            </div>
                            <span class="text-white font-bold">${formatTemp(maxT)}</span>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // ==========================================
        // 9. AUTO-REFRESH & INIT
        // ==========================================
        window.onload = function () {
            // Setup Date Picker bounds (Min: Today - 14 days, Max: Today + 14 days)
            const datePicker = document.getElementById('date-picker');
            if (datePicker) {
                const todayObj = new Date();
                const minObj = new Date(todayObj);
                minObj.setDate(todayObj.getDate() - 14);
                const maxObj = new Date(todayObj);
                maxObj.setDate(todayObj.getDate() + 14);

                datePicker.min = minObj.toISOString().split('T')[0];
                datePicker.max = maxObj.toISOString().split('T')[0];
                datePicker.value = selectedDate;
            }

            renderBeachTabs();
            fetchBeachData();

            // Refresh every 15 minutes
            autoRefreshInterval = setInterval(() => {
                fetchBeachData();
            }, 15 * 60 * 1000);
        };
    </script>
</body>
</html>
